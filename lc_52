public class lc_52 {

    static int count = 0;

    public static int totalNQueens(int n) {

        boolean[] cols = new boolean[n];
        boolean[] diag1 = new boolean[2 * n - 1];
        boolean[] diag2 = new boolean[2 * n - 1];

        solve(0, n, cols, diag1, diag2);

        return count;
    }

    private static void solve(int row, int n, boolean[] cols, boolean[] diag1, boolean[] diag2) {

        if (row == n) {
            count++;
            return;
        }

        for (int col = 0; col < n; col++) {

            if (cols[col]) {
                continue;
            }

            int d1 = row - col + n - 1;
            int d2 = row + col;

            if (diag1[d1] || diag2[d2]) {
                continue;
            }

            cols[col] = true;
            diag1[d1] = true;
            diag2[d2] = true;

            solve(row + 1, n, cols, diag1, diag2);

            cols[col] = false;
            diag1[d1] = false;
            diag2[d2] = false;
        }
    }

    public static void main(String[] args) {

        int n = 4;

        int result = totalNQueens(n);

        System.out.println("Number of solutions: " + result);
    }
}